PORT=8080
HOST=0.0.0.0
BHAI_CORE_API_KEY=

# Optional self-hosted/local inference (no API key)
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
HF_TOKEN=
HF_MODEL=HuggingFaceH4/zephyr-7b-beta
AI_PROVIDER_ORDER=ollama,gemini,openai,anthropic,huggingface


# Usage limits (0 = unlimited)
BHAI_MAX_REQUESTS=0
BHAI_MAX_INPUT_CHARS=0

BHAI_CORE_ADMIN_KEY=

BHAI_PROVIDER_RETRIES=2

BHAI_EMBEDDING_PROVIDER=local-hash
BHAI_EMBEDDING_DIMENSIONS=256
BHAI_OLLAMA_URL=http://127.0.0.1:11434
BHAI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# Optional local image generation via ComfyUI
COMFYUI_ENABLED=false
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=model.safetensors
BHAI_MAX_IMAGE_PROMPT_CHARS=4000

# Optional local voice runtimes
WHISPER_ENABLED=false
WHISPER_URL=http://127.0.0.1:9000
PIPER_ENABLED=false
PIPER_URL=http://127.0.0.1:5000
BHAI_MAX_AUDIO_BYTES=12000000
BHAI_MAX_TTS_CHARS=5000
\n# Memory / conversation context\nBHAI_MEMORY_MAX_MESSAGES=40\nBHAI_MEMORY_MAX_MESSAGE_CHARS=12000\nBHAI_MEMORY_MAX_CONTEXT_CHARS=30000\n
# Optional GitHub agent runtime
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_MS=15000
GITHUB_MAX_FILE_CHARS=1000000
