PORT=8080
HOST=0.0.0.0
BHAI_CORE_API_KEY=

# Optional master login gate for dashboard/API access
BHAI_CORE_USERNAME=
BHAI_CORE_PASSWORD=

# Optional self-hosted/local inference (no API key)
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
HF_TOKEN=
HF_MODEL=HuggingFaceH4/zephyr-7b-beta
AI_PROVIDER_ORDER=gemini,openai,anthropic,huggingface,ollama

# Usage limits (0 = unlimited)
BHAI_MAX_REQUESTS=0
BHAI_MAX_INPUT_CHARS=0

BHAI_CORE_ADMIN_KEY=

BHAI_PROVIDER_RETRIES=2

BHAI_EMBEDDING_PROVIDER=local-hash
BHAI_EMBEDDING_DIMENSIONS=256
BHAI_OLLAMA_URL=http://127.0.0.1:11434
BHAI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional local image generation via ComfyUI
COMFYUI_ENABLED=false
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=model.safetensors
BHAI_MAX_IMAGE_PROMPT_CHARS=4000

# Optional local voice runtimes
WHISPER_ENABLED=false
WHISPER_URL=http://127.0.0.1:9000
PIPER_ENABLED=false
PIPER_URL=http://127.0.0.1:5000
BHAI_MAX_AUDIO_BYTES=12000000
BHAI_MAX_TTS_CHARS=5000

# Memory / conversation context
BHAI_MEMORY_MAX_MESSAGES=40
BHAI_MEMORY_MAX_MESSAGE_CHARS=12000
BHAI_MEMORY_MAX_CONTEXT_CHARS=30000

# Optional GitHub agent runtime
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_MS=15000
GITHUB_MAX_FILE_CHARS=1000000

# Local Cloud build runner
BHAI_BUILD_RUNNER_ENABLED=false
BHAI_BUILD_TIMEOUT_MS=600000
BHAI_BUILD_MAX_OUTPUT_CHARS=200000

# Persistent worker job lease / crash recovery
BHAI_JOB_LEASE_MS=600000

# Cloud build log/artifact retention
BHAI_BUILD_MAX_LOG_EVENTS=1000
BHAI_BUILD_MAX_ARTIFACTS=100

# Persistent deployment storage
BHAI_DEPLOYMENT_ROOT=/var/lib/bhai-core/deployments

# GitHub push webhook for auto-deploy
BHAI_GITHUB_WEBHOOK_SECRET=

# Cloud runtime
BHAI_RUNTIME_ENABLED=false
BHAI_RUNTIME_START_TIMEOUT_MS=30000
BHAI_RUNTIME_MAX_OUTPUT_CHARS=50000
BHAI_RUNTIME_MAX_RESTARTS=3
BHAI_RUNTIME_HEALTH_INTERVAL_MS=15000

# Cloud network routing
BHAI_NETWORK_PROXY_TIMEOUT_MS=15000
BHAI_NETWORK_TLS=false

# Cloud service port allocation
BHAI_SERVICE_PORT_START=10000
BHAI_SERVICE_PORT_END=20000

# Automatically start successful deployments with a detected start command
BHAI_AUTO_START_DEPLOYMENTS=false

# Optional HTTPS/TLS termination for custom domains
BHAI_TLS_ENABLED=false
BHAI_TLS_HOST=0.0.0.0
BHAI_TLS_PORT=8443
BHAI_TLS_CERT_FILE=
BHAI_TLS_KEY_FILE=
BHAI_TLS_MIN_VERSION=TLSv1.2

# GitHub webhook replay-protection retention (milliseconds)
BHAI_WEBHOOK_REPLAY_TTL_MS=86400000

# ACME/custom-domain certificate lifecycle
BHAI_ACME_ENABLED=false
BHAI_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
BHAI_ACME_EMAIL=
BHAI_ACME_RENEW_BEFORE_DAYS=30
BHAI_ACME_POLL_MS=5000

# DNS challenge verification
BHAI_DNS_RESOLVER_TIMEOUT_MS=5000

# ACME account private-key encryption (required when ACME issuance is enabled)
BHAI_ACME_MASTER_KEY=

BHAI_RATE_LIMIT_ENABLED=true
BHAI_RATE_LIMIT_WINDOW_MS=60000
BHAI_RATE_LIMIT_MAX=120

# Certificate renewal sweep
BHAI_ACME_RENEWAL_INTERVAL_MS=3600000
BHAI_STORE_MAX_BYTES=10485760
BHAI_STORE_BACKUP=true

# Persistent store backend: json (default) or postgres
BHAI_STORE_BACKEND=json
DATABASE_URL=
BHAI_STORE_PG_TABLE=bhai_core_store
BHAI_STORE_PG_POOL_MAX=5
BHAI_STORE_PG_CONNECT_TIMEOUT_MS=10000
BHAI_STORE_PG_IDLE_TIMEOUT_MS=30000
BHAI_STORE_PG_SSL=true

VIDEO_API_URL=
VIDEO_API_KEY=
