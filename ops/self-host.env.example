# Copy to .env on your own host. Never commit the real file.
BHAI_ENGINE_URL=mobile://local
BHAI_ENGINE_MODEL=smollm2.gguf
BHAI_MOBILE_NODE_TOKEN=replace-with-your-mobile-node-token
BHAI_CORE_BOOTSTRAP_API_KEY=replace-with-a-long-random-api-key
BHAI_CORE_USERNAME=admin
BHAI_CORE_PASSWORD=replace-with-a-strong-password

# Optional: your own NVIDIA-GPU image server (start docker-compose.image.yml first).
# COMFYUI_URL=http://image-engine:8188
# BHAI_IMAGE_WORKFLOW=flux-schnell
# COMFYUI_CHECKPOINT=flux1-schnell-fp8.safetensors
# BHAI_IMAGE_STEPS=4
